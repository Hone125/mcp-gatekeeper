# 把这个文件复制成 .env 再填值。.env 已被 .gitignore 排除，绝不会入库。
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# ★ 先读这一条：**「跑评测」和「发布自检」是两个状态，不能同时成立。**
#   本仓有一条检查（`tests/test_repo_hygiene.py` 与收尾自检第 7 项）
#   要求工作区里**没有** `.env` —— 哪怕它被 gitignore 了也一样。
#   所以照上面两行做完之后，`pytest` 会有 1 条红、收尾自检第 7 项会 FAIL。
#   这不是坏了，是设计如此（理由见 `DECISIONS.md` D-43）。
#
#   两种走法各选一头：
#     · 要跑评测 → 留着 `.env`，接受那两条红；
#     · 要发布   → 用环境变量代替 `.env`（下面「LLM」那节的值改成
#                  $env:LLM_API_KEY = "..." 之类），工作区就一直是干净的。
#
# ★ 只有下面「LLM」那一节会被从 .env 里读（由 mcp_server/env_file.py 在
#   `real_llm()` 里读一次，显式设过的环境变量优先）。
#   **其余各节请用真实环境变量设置**，它们不从 .env 读。
#   理由：那些键决定「怎么验签」和「读哪个目录」——让一个凭据文件能把数据根
#   指到别处，是件危险的事，而不只是不方便。
#
# ★ 只有「问数据库（自然语言转 SQL）」这一条链路需要 LLM。
#   协议层、鉴权、SQL 护栏、知识库检索、MCP 握手全部**不需要** LLM，
#   所以不填这个文件也能跑通 `pytest` 和 experiments/10、11、08。

# ---- LLM（OpenAI 兼容接口，任何一家都行）★ 只有这一节从 .env 读 ----
# 必填。形如 sk-... 的密钥。
LLM_API_KEY=
# 可选。默认值为空 —— 留空时必须显式填写，脚本不会替你猜一个端点。
# ★ 填的是 **base**，不是完整的补全地址：写到 `/v1` 为止，**不要带
#   `/chat/completions`**。SDK 会自己往后面拼那一段，写全了会变成
#   `.../v1/chat/completions/chat/completions`，报 404。
# 示例（按你自己的服务商填）：
#   https://api.siliconflow.cn/v1
#   https://api.deepseek.com/v1
#   https://api.openai.com/v1
LLM_BASE_URL=
# 可选。模型 id，需要与服务商的命名一致。
LLM_MODEL=
# 可选。单次请求超时（秒），默认 120。
LLM_TIMEOUT=120

# ---- 鉴权 ----
# 可选。HMAC 签名密钥。**留空时使用内置的开发用默认值**，
# 服务端启动时会打印醒目告警。生产环境必须显式设置一个高熵随机值。
MCP_JWT_SECRET=
# 可选。令牌的签发方与受众，默认 mcp-guarded-toolkit / mcp-client。
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=

# ---- 限流退避（可选）----
# 命中限流时的重试次数与初始退避秒数，退避按 2 的幂增长、90 秒封顶。
LLM_RETRY=6
LLM_BACKOFF=8
