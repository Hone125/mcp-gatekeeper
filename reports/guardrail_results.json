  "l1_allow": [
    {
      "label": "最普通的查询，缺 LIMIT",
      "sql": "SELECT Title FROM Album",
      "expect": "rewritten",
      "expect_text": "改写（补 LIMIT，非拒绝）",
      "got": "放行，补 LIMIT=True",
      "exit": 0,
      "layer": "",
      "why": "缺 LIMIT 是**改写**（补 `LIMIT 200` 并在返回体标 `limit_injected`），不是拒绝。这条规则防的是内存被打满，不是安全；拒绝会让上游为一句话反复重写、白烧调用次数。",
      "extra": [],
      "detail": {
        "layer": "L2+L3",
        "ok": true,
        "blocked": false,
        "sql": "SELECT Title FROM Album LIMIT 200",
        "columns": [
          "Title"
        ],
        "n_rows": 200,
        "truncated": false,
        "limit_injected": true,
        "comments_removed": 0
      },
      "pass": true
    },
    {
