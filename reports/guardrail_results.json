    {
      "label": "字符串字面量里有 --",
      "sql": "SELECT * FROM Album WHERE Title = 'a--b'",
      "expect": "rewritten",
      "expect_text": "改写（补 LIMIT，非拒绝）",
      "got": "放行，补 LIMIT=True",
      "exit": 0,
